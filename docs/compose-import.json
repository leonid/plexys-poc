{
  "compose": {
    "version": "1.0",
    "namespaces": [
      {
        "name": "Plexys Homework",
        "handle": "plexys-homework",
        "modules": [
          {
            "name": "Customer",
            "handle": "customer",
            "fields": [
              {
                "name": "name",
                "kind": "String",
                "label": "Customer Name",
                "required": true
              },
              {
                "name": "email",
                "kind": "Email",
                "label": "Email",
                "required": false
              },
              {
                "name": "company",
                "kind": "String",
                "label": "Company",
                "required": false
              }
            ]
          },
          {
            "name": "Support Ticket",
            "handle": "support_ticket",
            "fields": [
              {
                "name": "subject",
                "kind": "String",
                "label": "Subject",
                "required": true
              },
              {
                "name": "description",
                "kind": "Text",
                "label": "Description",
                "required": false
              },
              {
                "name": "status",
                "kind": "Select",
                "label": "Status",
                "required": true,
                "options": ["New", "In Progress", "Resolved", "Closed"]
              },
              {
                "name": "priority",
                "kind": "Select",
                "label": "Priority",
                "required": true,
                "options": ["Low", "Medium", "High", "Urgent"]
              },
              {
                "name": "dueDate",
                "kind": "DateTime",
                "label": "Due Date",
                "required": false
              },
              {
                "name": "customer",
                "kind": "Record",
                "label": "Customer",
                "required": false,
                "options": {
                  "module": "customer"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "note": "Corteza Compose schema definition for Support Ticket & Customer modules. Import via Corteza Compose UI or configure manually."
}
